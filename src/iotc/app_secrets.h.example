/*
 * app_secrets.h.example - copy to app_secrets.h (gitignored) and fill in.
 *
 * Get CPID + ENV from IoTConnect: Settings -> Key Vault.
 * Create the device with an X.509 (self-signed or CA) certificate and paste
 * the device certificate + private key below.
 */
#ifndef IOTC_APP_SECRETS_H
#define IOTC_APP_SECRETS_H

#define IOTC_CFG_ENABLED 1

#define IOTC_CFG_ENV  "poc"
#define IOTC_CFG_CPID "YOURCPIDHERE"
#define IOTC_CFG_DUID "ek-ra8p1-01"

#define IOTC_CFG_DEVICE_CERT_PEM \
    "-----BEGIN CERTIFICATE-----\n" \
    "...\n" \
    "-----END CERTIFICATE-----\n"

#define IOTC_CFG_DEVICE_KEY_PEM \
    "-----BEGIN RSA PRIVATE KEY-----\n" \
    "...\n" \
    "-----END RSA PRIVATE KEY-----\n"

#endif /* IOTC_APP_SECRETS_H */
